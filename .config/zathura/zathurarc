include gruvbox-light-soft

set selection-clipboard "clipboard"

map <F1> focus_inputbar ":source"
map <F2> focus_inputbar ":exec change_zathura_theme gruvbox-light-soft"
map <F3> focus_inputbar ":exec change_zathura_theme gruvbox-dark-hard"

map <C-l> feedkeys "<F2><Return><F1><Return>"
map <C-d> feedkeys "<F3><Return><F1><Return>"
map <C-w> recolor

set scroll-step 100
