
(defwidget toggles-block [] 
    (box    :class "root"
        (box    :orientation "v"
                :spacing 0
                :space-evenly false
            (box :orienation "h"
                (toggle :texton "󱄄" :textoff "󰶐" :funcon "compfy -b" :funcoff "killall compfy" :var compositor_toggle :varname "compositor_toggle")
                (toggle :texton "󰭶" :textoff "󱘂" :funcon "xinput enable 14" :funcoff "xinput disable 14" :var touchscreen_toggle :varname "touchscreen_toggle")
                (toggle :texton "󰟸" :textoff "󰤳" :funcon "xinput enable 10" :funcoff "xinput disable 10" :var touchpad_toggle :varname "touchpad_toggle")
                (toggle :texton "󰡖" :textoff "󰄷" 
                                :funcon "awesome-client 'local bling=require(\"bling\"); bling.module.window_swallowing.start()'" 
                                :funcoff "awesome-client 'local bling=require(\"bling\"); bling.module.window_swallowing.stop()'" 
                                :var swallowing_toggle :varname "swallowing_toggle")
            )
            (box :orienation "h"
                :space-evenly false
                (label :class "side_icon" :text "󱃮")
                (scale :orienation "h"
                    :valign "start"
                    :hexpand true
                    :class "scale"
                    :value gamma_value
                    :min 0
                    :max 11
                    :round-digits 0
                    :onchange "~/bin/set_gamma {}"
                )
            )
            (box :orienation "h"
                :space-evenly false
                (label :class "side_icon" :text "󱩌")
                (scale :orienation "h"
                    :valign "start"
                    :hexpand true
                    :class "scale"
                    :value redshift_value
                    :min 0
                    :max 11
                    :round-digits 0
                    :onchange "$HOME/bin/set_redshift {}"
                )
            )
            (box :orienation "h"
                (button :class "button"
						:onclick "setxkbmap gb"
                    " "
                )
                (toggle :texton "󰟸+  " :textoff "󰤳+  " :funcon "~/bin/toggle_touchpad_while_typing 0" :funcoff "~/bin/toggle_touchpad_while_typing 1" :var touchpad_while_typing_toggle :varname "touchpad_while_typing_toggle")
            )
        )
    )
)


(defwidget toggle [texton textoff funcon funcoff var varname]
    (button :class "toggle"
            :onclick {var ? "eww update ${varname}=false; ${funcoff}" : "eww update ${varname}=true; ${funcon}"}
            :width 120
            :height 100
            :timeout "200ms"
    {var ? texton : textoff})
)

(defvar compositor_toggle true)
(defvar touchscreen_toggle true)
(defvar touchpad_toggle true)
(defvar swallowing_toggle true)
(defvar touchpad_while_typing_toggle false)
(deflisten redshift_value :initial "0" "tail -F /tmp/redshift_10")
(deflisten gamma_value :initial "0" "tail -F /tmp/gamma_10")
