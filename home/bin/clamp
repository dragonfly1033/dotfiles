#!/bin/python

import sys

def usage():
    print("Usage: clamp <min> <max> [value]")
    print("     min <= max, value from stdin if omitted")
    quit()

argc = len(sys.argv)
if argc == 3:
    m = float(sys.argv[1])
    M = float(sys.argv[2])
    value = float(input())
elif argc == 4:
    m = float(sys.argv[1])
    M = float(sys.argv[2])
    value = float(sys.argv[3])
else:
    usage()

print(min(max(value, m), M))

