from math import comb as choose
from random import random as rand
from random import randint as rint
import random
from fractions import Fraction as F
import os

import numpy as np

phi = 1.61803399

import sys
sys.ps1 = ""
sys.ps2 = ""

print("Calculator")

def sind(a): return sin(radians(a))
def cosd(a): return cos(radians(a))
def tand(a): return tan(radians(a))
def asind(a): return degrees(asin(a))
def acosd(a): return degrees(acos(a))
def atand(a): return degrees(atan(a))
def atan2d(y, x): return degrees(atan2(y, x))

def is_prime(n):
	prime = True
	for i in range(2, int(sqrt(n))+1):
		if n % i == 0:
			return False
	return True

def decomp(n):
	os.system(f"factor {n}")

def sign(a):
	return 1 * (a > 0) -1 * (a < 0)

def D(n):
    return [i for i in range(1, n+1) if n%i==0]

def CD(m, n):
    return [i for i in range(1, max(m, n)+1) if m%i==0 and n%i==0]

def gcd(m, n):
    if m%n == 0:
        return n
    else:
        return gcd(n, m%n)

