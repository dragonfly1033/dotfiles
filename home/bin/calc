def cal(args=""):
    os.system("cal " + args)
class st(type):
    def __repr__(cls): 
        os.system("cal")
        return ""
    def __sub__(cls, other):
        os.system("cal -n"+str(other))
class cal(metaclass=st): pass

# td(days=388, seconds=32917)
class td(timedelta):
    def __init__(self, *args, **kwargs):
        super().__init__()

    def __repr__(self):
        s = self.total_seconds()
        y, r = divmod(s, 31536000) 
        w, r = divmod(r, 604800)
        d, r = divmod(r, 86400)
        h, r = divmod(r, 3600)
        m, s = divmod(r, 60)
        ans = f'{round(y)} years,'*(y != 0) + \
              f'{round(w)} weeks,'*(w != 0) + \
              f'{round(d)} days,'*(d != 0) + \
              f'{round(h)} hours,'*(h != 0) + \
              f'{round(m)} minutes,'*(m != 0) + \
              f'{round(s)} seconds,'*(s != 0)
        return ans[:-1]


class Vec:
    def __init__(self, *args):
        self.vals = args

    def __add__(self, other):
        if len(self.vals) != len(other.vals): raise ValueError("diff lens")
        return [self.vals[i] + other.vals[i] for i in range(len(self.vals))]

        


