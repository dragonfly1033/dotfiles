#!/bin/sh

# Initialize variables
mouse_kb=false
enable=false

# Process options
for arg in "$@"
do
 case "$arg" in
    --mousekb)
      mouse_kb=true
      shift
      ;;
    --enable)
      enable=true
      shift
      ;;
    *)
      echo "Unknown option: $arg"
      exit 1
      ;;
 esac
done


if [ "$enable" = true ]; then
    awesome-client 'bar_auto=false'
else
    awesome-client 'bar_auto=true'
    ~/bin/toggle_mouse_on_keyboard unset
fi

# Check if any options were used
if [ "$mouse_kb" = true ] && [ "$enable" = true ]; then
    ~/bin/toggle_mouse_on_keyboard set
fi

