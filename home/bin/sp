#!/bin/sh

if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    word=$(wl-paste --primary | tee /tmp/word) 
else
    word=$(xclip -seletion primary -o | tee /tmp/word)
fi
notify-send "Checking word" "$word"

new=$(dmenu "$(aspell -a < /tmp/word | tail +2 | cut -d':' -f2 | tr -d ' ' | tr ',' '\n')" "Words: ")
echo "$new"

if ! [ -z "$new" ] && ! [ "$new" = "*" ]; then
    xdotool type "$new"
fi

