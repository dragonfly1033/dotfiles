#!/bin/sh

tags=$(awerun "for s in screenO do; print(s.selected_tag.name); end" | sed -r '/"/d; /^$/d; s/(.*)/'"'\1'/" | tr '\n' ',' | sed -r 's/,$//')

awesome-client 'awesome.restart()'

sleep 1

awerun "
local tmptags = { $tags }
local tmpi = 1
for s in screenO do
    awful.tag.find_by_name(
        s, tmptags[tmpi]     
    ):view_only()
    tmpi = tmpi + 1
end
"
