#!/bin/sh

usage () {
    echo "Usage: brightness <inc|dec|set|get> [delta|value]"
}

get_gamma () {
    if [ -f /tmp/gamma_10 ]; then
        gamma=$(tail -n1 /tmp/gamma_10)
    else
        gamma="10"
    fi

    echo "$gamma" | cut -d'.' -f1
}

gamma="2.2"

if [ "$XDG_SESSSION_TYPE" = "wayland" ]; then
    monitors=$(niri msg outputs | grep -Ec " Output")
else
    monitors=$(xrandr -q | grep -Ec " connected")
fi

operation="$1"

if [ "$operation" = "get" ]; then
    gamma=$(get_gamma)
    bl=$(brightnessctl get)
    echo "gamma: $gamma"
    echo "backlight: $bl"
elif [ "$operation" = "set" ]; then
    new="$2"
    [ -z "$new" ] && usage
    { [ "$new" -lt 0 ] || [ "$new" -gt 10 ]; } && echo "set value must be [0,10]" && exit 1
    
    if [ "$monitors" -gt 1 ]; then
        brightnessctl --exponent="$gamma" set "100%"
        ~/bin/set_redshift -g "$new"
    else
        brightnessctl --exponent="$gamma" set "$((new * 10))%"
    fi
elif [ "$operation" = "inc" ]; then
    if [ "$monitors" -gt 1 ]; then
        brightnessctl --exponent="$gamma" set "100%"
        gamma=$(get_gamma)
        new=$(("$gamma" + 1)) 
        new=$(echo "$new" | clamp 0 10 | cut -d'.' -f1)
        ~/bin/set_redshift -g "$new"
    else
        brightnessctl --exponent="$gamma" set "+10%"
    fi
elif [ "$operation" = "dec" ]; then
    if [ "$monitors" -gt 1 ]; then
        brightnessctl --exponent="$gamma" set "100%"
        gamma=$(get_gamma)
        new=$(("$gamma" - 1)) 
        new=$(echo "$new" | clamp 0 10 | cut -d'.' -f1)
        ~/bin/set_redshift -g "$new"
    else
        brightnessctl --exponent="$gamma" set "10%-"
    fi
else 
    usage
fi  