#!/bin/python

import sys
import os
import subprocess

env = os.environ.get


def adjust(a):
    return min(max(int(round(14*(100*a/255)**0.426)), 0), 100)

def unadjust(a):
    return min(max(int(round(2.55*(a/14)**2.3474)), 0), 255)

action = sys.argv[1]
a = int(str(subprocess.check_output(["brightnessctl", "get"]))[2:-3])

if action == "get":
    print(f"{adjust(a)}%")
elif action == "inc":
    extra = int(sys.argv[2])
    cur = adjust(a)
    cur = min(max(cur+extra, 0), 100)
    new = unadjust(cur)
    subprocess.run(["brightnessctl", "set", f"{new}"])
elif action == "dec":
    extra = int(sys.argv[2])
    cur = adjust(a)
    cur = min(max(cur-extra, 0), 100)
    new = unadjust(cur)
    subprocess.run(["brightnessctl", "set", f"{new}"])
elif action == "set":
    new = int(sys.argv[2])
    new = unadjust(new)
    subprocess.run(["brightnessctl", "set", f"{new}"])

