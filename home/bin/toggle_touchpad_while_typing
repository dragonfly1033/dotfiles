#!/bin/sh

dev_id=$(xinput | grep "Touchpad" | sed -r 's/.*id=([0-9]+).*/\1/')
prop_id=$(xinput list-props "$dev_id" | grep -e "Disable While Typing" | sed '/.*Default.*/d' | sed -r 's/.*\(([0-9]+)\).*/\1/')

new_state="$1"

if [ "$new_state" = "enable" ]; then
    xinput set-int-prop "$dev_id" "$prop_id" 8 0
elif [ "$new_state" = "disable" ]; then
    xinput set-int-prop "$dev_id" "$prop_id" 8 1
else
    echo "Usage toggle_touchpad_while_typing [enable|disable]"
    exit 1 
fi


