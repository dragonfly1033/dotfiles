#!/bin/sh

ups=$(checkupdates 2>&1 | awk -F'[ -]' '{print $1}' | sort | uniq)
n=$(echo "$ups" | wc -l)
LIMIT=80

message="$n"

plain="$1"

case "$ups" in
	*"==>"*) echo "" ;;
	*) 	if [ "$n" -ge "$LIMIT" ] && [ -z "$plain" ]; then
			message="%{F#f00}$message"
		fi
        if (echo "$ups" | grep -e "grub" > /dev/null ); then 
            message="$message!"
        fi
		echo "$message"
		;;
esac
