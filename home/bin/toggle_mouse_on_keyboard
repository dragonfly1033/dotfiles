#!/bin/sh

state="$1"

if [ "$state" = "enable" ]; then
    setxkbmap -option keypad:pointerkeys
    toggle_keybind_section mouse_on_kb enable
    killall sxhkd && sxhkd &
elif [ "$state" = "disable" ]; then
    setxkbmap -option
    toggle_keybind_section mouse_on_kb disable
    killall sxhkd && sxhkd &
else
    echo "Usage: toggle_mouse_on_keyboard [enable|disable]"
    exit
fi
    

