#!/bin/sh

options=$1
prompt=$2

if [ -z "$options" ] && [ -z "$prompt" ]; then
	echo "Usage: dmenu <options> <prompt>"
	echo "      options reads from stdin if -"
	exit 1
fi

if [ "$options" = "-" ]; then
    while read -r line; do
        echo "$line"
    done | rofi -dmenu -i -p " $prompt  "
else
    echo -e "$options" | rofi -dmenu -i -p " $prompt  "
fi