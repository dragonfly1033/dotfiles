#!/bin/sh

if [ "$1" = "--help" ]; then
    echo "USAGE: awerun <lua file|lua string> [delay duration]"
    exit 0
fi

if [ -f "$1" ]; then
    script=$(cat "$1")
else
    script="$1"
fi


cmd="
local gears = require('gears')
local awful = require('awful')
local beautiful = require('beautiful')
local naughty = require('naughty')
local scratch = require('scratchpads')
local bling = require('bling')
local menubar = require('menubar')

function notif(...)
    local arg = {...}
    s = ''
    for i = 1, #arg-1 do
        s = s .. tostring(arg[i]) .. ' | '
    end
    s = s .. tostring(arg[#arg])
    naughty.notify({text=tostring(s), position='top_middle', timeout=5})
end

function notif_table(t)
	for k, v in pairs(t) do
	  notif(tostring(k) .. ' : ' .. tostring(v))
	end
end

function print(s, d)
	d = d or '\n'
	stdout_str = stdout_str .. tostring(s) .. d
end

function prints(...)
	local arg = {...}
    s = ''
    for i = 1, #arg-1 do
        s = s .. tostring(arg[i]) .. ' | '
    end
    s = s .. tostring(arg[#arg])
	stdout_str = stdout_str .. tostring(s) .. '\n'
end

function print_table(t)
	for k, v in pairs(t) do
		print(tostring(k)..' : '..tostring(v))
	end
end

function spawn(c)
    awful.spawn.with_shell(c)
end

local HOME = os.getenv('HOME')

local screenO = screen
local screen = awful.screen.focused()
local tag = screen.selected_tag
local tags = screen.tags
local clients = tag:clients()
local client = client.focus

stdout_str = ''

$script

stdout_str = '\n' .. stdout_str .. '\n'
return stdout_str
"

dur=$2

if [ "$dur" = "" ]; then
	dur=0
fi

sleep "$dur"

awesome-client "$cmd"
