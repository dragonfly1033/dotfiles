# 	echo "No Addition"
# 	ls -1 $DOWN | sort > /tmp/old_downloads
# 	d=$(ls -1At $DOWN | head -n 1)
# 	echo "$DOWN/$d" | xclip -selection clipboard
# 	echo "$DOWN/$d"
# else
# 	echo "Addition $d"
# 	echo "$DOWN/$d" > /tmp/last_download
# 	echo "$DOWN/$d" | xclip -selection clipboard
# 	echo "$DOWN/$d"
# 	ls -1 $DOWN | sort > /tmp/old_downloads
# fi


